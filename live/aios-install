#!/bin/sh
# AIOS installer: install the AIOS system to a local disk
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
set -e

VERBOSE="${VERBOSE:-0}"
AUTO="${AUTO:-}"
for _a in "$@"; do
  case "$_a" in
    --verbose|-v) VERBOSE=1 ;;
  esac
done

JOURNAL=/mnt/target/aios-install.log
step() {
  _ts=$(date +%H:%M:%S 2>/dev/null || true)
  echo "[$_ts] $*"
  if grep -q " /mnt/target " /proc/mounts 2>/dev/null; then
    echo "[$_ts] $*" >> "$JOURNAL"
  fi
}

echo ""
echo "============================================="
echo "  AIOS Installer"
echo "  Installs AIOS to a local disk (GPT: BIOS boot + ESP + root)."
echo "============================================="
echo ""

lsblk -o NAME,SIZE,TYPE,MODEL 2>/dev/null || for d in /sys/block/sd* /sys/block/vd* /sys/block/nvme*; do basename "$d"; done

echo ""
echo -n "Target disk (e.g. sda, nvme0n1): "
read TARGET
DEV=/dev/$TARGET

[ -b "$DEV" ] || { echo "ERROR: $DEV is not a block device"; exit 1; }

echo ""
echo "WARNING: ALL DATA on $DEV will be destroyed!"
echo -n "Type YES to continue: "
read CONFIRM
[ "$CONFIRM" = "YES" ] || { echo "Aborted."; exit 1; }

_old_install=$(blkid -s LABEL -o value "${DEV}3" 2>/dev/null || true)
if [ "$_old_install" = "AIOS" ] && [ "$AUTO" != "1" ]; then
  echo "WARNING: $DEV root partition is labeled AIOS - a previous install detected."
  echo -n "Type YES to FORCE reinstall: "
  read FORCE
  [ "$FORCE" = "YES" ] || { echo "Aborted."; exit 1; }
fi

echo "Unmounting existing partitions..."
umount "${DEV}"* 2>/dev/null || true

echo "Partitioning $DEV (GPT)..."
wipefs -a "$DEV" 2>/dev/null || true
sfdisk --wipe always "$DEV" <<'EOF'
label: gpt
size=1M, type=21686148-6449-6E6F-744E-656564454649
size=512M, type=uefi, bootable
,,
EOF

sleep 2
partprobe "$DEV" 2>/dev/null || true
sleep 2

echo "Formatting partitions..."
mkfs.fat -F 32 -I -n AIOS-EFI "${DEV}2"
mkfs.ext4 -F -L AIOS "${DEV}3"

echo "Mounting target..."
mkdir -p /mnt/target /mnt/esp
mount "${DEV}3" /mnt/target
mkdir -p /mnt/target/boot/efi
mount "${DEV}2" /mnt/target/boot/efi

: > "$JOURNAL"
step "AIOS Installer start on $DEV"
step "root size: $(lsblk -bno SIZE "${DEV}3" 2>/dev/null || true) bytes (rest of disk)"
[ "$VERBOSE" = 1 ] && { echo "[VERBOSE] partition table:"; sfdisk --dump "$DEV" || true; }

echo "Copying system (this may take a while)..."
cd /
tar cf - --exclude=proc --exclude=sys --exclude=dev --exclude=run --exclude=mnt \
         --exclude=tmp --exclude=media --exclude='var/tmp' --exclude='var/log' \
         --exclude='var/cache' --exclude='var/run' . | tar xf - -C /mnt/target
step "system copied"

# ---------------------------------------------------------------------------
# Optional block set selected at install time.
#
# The live media carries a block catalog; the compiled-in base set (hal,
# browser, net_settings, ipc_bus, scheduler) is part of the kernel binary and
# is not listed here. The chosen subset is copied into the installed system's
# /blocks directory, which the kernel reads through AIOS_BLOCKS_DIR. The final
# selection is recorded in /etc/aios/blocks.conf on the target.
# ---------------------------------------------------------------------------
BLOCK_CATALOG=/usr/share/aios/blocks
BLOCK_DEFAULT_CONF=/etc/aios/blocks.conf
TARGET_BLOCKS=/mnt/target/blocks
TARGET_BLOCK_CONF=/mnt/target/etc/aios/blocks.conf

install_blocks() {
  mkdir -p "$TARGET_BLOCKS" "$(dirname "$TARGET_BLOCK_CONF")"

  if [ ! -d "$BLOCK_CATALOG" ]; then
    step "no block catalog at $BLOCK_CATALOG; base set only"
    return 0
  fi

  available=$(cd "$BLOCK_CATALOG" 2>/dev/null && for f in *.wasm *.bin; do
    [ -e "$f" ] || continue
    b=${f%.*}
    printf '%s\n' "${b%%_*}"
  done | sort -u | tr '\n' ' ')

  if [ -z "$available" ]; then
    step "block catalog empty; base set only"
    return 0
  fi

  default_sel="all"
  if [ -f "$BLOCK_DEFAULT_CONF" ]; then
    d=$(grep -v '^[[:space:]]*#' "$BLOCK_DEFAULT_CONF" 2>/dev/null | tr '\n' ' ')
    [ -n "$d" ] && default_sel="$d"
  fi

  if [ "$AUTO" = "1" ]; then
    selection="$default_sel"
  else
    echo ""
    echo "Available blocks: $available"
    echo -n "Blocks to install [all/none/name ...] (default: $default_sel): "
    read selection
    [ -n "$selection" ] || selection="$default_sel"
  fi

  case "$selection" in
    all)  names="$available" ;;
    none) names="" ;;
    *)    names="$selection" ;;
  esac

  installed=""
  for n in $names; do
    got=0
    for f in "$BLOCK_CATALOG/${n}"_*.wasm "$BLOCK_CATALOG/${n}"_*.bin; do
      [ -e "$f" ] || continue
      cp -f "$f" "$TARGET_BLOCKS/"
      side="${f%.*}.json"
      [ -f "$side" ] && cp -f "$side" "$TARGET_BLOCKS/"
      got=$((got + 1))
    done
    if [ "$got" -gt 0 ]; then
      installed="$installed $n"
    else
      echo "-- WARNING: block '$n' not found in catalog"
    fi
  done

  {
    echo "# Written by aios-install. Blocks installed into /blocks."
    for n in $installed; do echo "$n"; done
  } > "$TARGET_BLOCK_CONF"

  step "blocks installed:${installed:- none}"
}

install_blocks

echo "Installing GRUB..."
if [ -f /usr/sbin/grub-install ]; then
  echo "-- grub-install found in PATH: $(command -v grub-install)"
  grub-install --boot-directory=/mnt/target/boot --target=i386-pc "$DEV" > /mnt/target/grub-err.txt 2>&1
  grub_rc=$?
  echo "-- BIOS grub rc=$grub_rc"
  step "BIOS grub rc=$grub_rc"
  [ $grub_rc -eq 0 ] || tail -30 /mnt/target/grub-err.txt
else
  echo "-- grub-install MISSING"
  step "BIOS grub MISSING"
fi
if [ -d /usr/lib/grub/x86_64-efi ] && [ -f /usr/sbin/grub-install ]; then
  grub_err=$(grub-install --boot-directory=/mnt/target/boot --target=x86_64-efi --removable 2>&1)
  grub_rc=$?
  echo "-- EFI grub rc=$grub_rc"
  step "EFI grub rc=$grub_rc"
  [ $grub_rc -eq 0 ] || echo "$grub_err" | head -20
fi

mkdir -p /mnt/target/boot/grub
echo "-- creating grub.cfg"
cat > /mnt/target/boot/grub/grub.cfg <<GRUB
set timeout=5
set default=0
menuentry "AIOS" {
  linux /boot/vmlinuz root=${DEV}3 console=tty0 quiet
  initrd /boot/initramfs.cpio.gz
}
GRUB
step "grub.cfg written (root=${DEV}3)"

step "AIOS INSTALL COMPLETE"
sync
echo ""
echo "Install journal on target (/aios-install.log):"
cat "$JOURNAL"
sync
umount /mnt/target/boot/efi
umount /mnt/target

echo ""
echo "============================================="
echo "  AIOS has been installed to $DEV"
echo "  You can now reboot."
echo "============================================="